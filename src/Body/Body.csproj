<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0 (2026-10-22) brings the WinRT projection for Windows' now-playing feed (NowPlaying.cs, SMTC).
         The output folder is pinned to the old name so every shortcut, autostart entry and test that points at
         bin\Release\net10.0-windows\Aang.exe keeps working. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Aang</AssemblyName>
    <!-- Aang's face on the exe itself (2026-10-21), so the desktop shortcut, the Start menu and a pin all show him;
         the same hand-pixelled 16-256 icon the Shell's windows wear. -->
    <ApplicationIcon>..\Shell\assets\aang.ico</ApplicationIcon>
    <RootNamespace>Aang.Body</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Body.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\**\*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
