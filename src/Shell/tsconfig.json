{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["es2023", "dom"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "pages/reveal.js", "pages/asks.js", "pages/entities.js", "pages/scrollback.js"]
}
